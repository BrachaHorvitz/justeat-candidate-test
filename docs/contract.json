{
  "openapi": "3.1.0",
  "info": { "title": "Employees API", "version": "1.0.0",
    "description": "Interview task. Implement every operation below against the provided Postgres database. Expose interactive docs (Swagger UI or Scalar)." },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {
    "/employees/search": {
      "post": {
        "operationId": "searchEmployees",
        "summary": "Search employees (filter + pagination)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeSearch" } } } },
        "responses": {
          "200": { "description": "Page of employees", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeePage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/employees": {
      "post": {
        "operationId": "createEmployee",
        "summary": "Create an employee",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeInput" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Employee" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/employees/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": {
        "operationId": "getEmployee",
        "summary": "Get one employee by id",
        "responses": {
          "200": { "description": "Employee", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Employee" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "replaceEmployee",
        "summary": "Replace an employee (full update)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeInput" } } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Employee" } } } },
          "409": { "$ref": "#/components/responses/Conflict" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Department": { "type": "string", "enum": ["HR", "R&D", "Maintenance", "Sales", "Finance"] },
      "Gender": { "type": "string", "enum": ["male", "female", "other"] },
      "Address": { "type": "object", "required": ["street", "city"],
        "properties": { "street": { "type": "string" }, "city": { "type": "string" }, "zip": { "type": "string" } } },
      "EmployeeSearch": { "type": "object", "additionalProperties": false,
        "properties": {
          "department": { "$ref": "#/components/schemas/Department" },
          "gender": { "$ref": "#/components/schemas/Gender" },
          "minAge": { "type": "integer", "minimum": 0 },
          "maxAge": { "type": "integer", "minimum": 0 },
          "search": { "type": "string", "description": "Case-insensitive match on first or last name" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } },
      "EmployeeInput": { "type": "object", "additionalProperties": false,
        "required": ["firstName", "lastName", "birthDate", "gender", "address", "department"],
        "properties": {
          "firstName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "lastName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "birthDate": { "type": "string", "format": "date" },
          "gender": { "$ref": "#/components/schemas/Gender" },
          "address": { "$ref": "#/components/schemas/Address" },
          "department": { "$ref": "#/components/schemas/Department" } } },
      "Employee": { "allOf": [ { "$ref": "#/components/schemas/EmployeeInput" },
        { "type": "object", "required": ["id", "age"],
          "properties": { "id": { "type": "integer" },
            "age": { "type": "integer", "description": "Computed from birthDate at request time; not stored" } } } ] },
      "EmployeePage": { "type": "object", "required": ["items", "total", "page", "pageSize"],
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Employee" } },
          "total": { "type": "integer", "description": "Total matching rows across all pages" },
          "page": { "type": "integer" }, "pageSize": { "type": "integer" } } },
      "Error": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" }, "details": {} } }
    },
    "responses": {
      "BadRequest": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "A person with the same first name, last name, and birth date already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
